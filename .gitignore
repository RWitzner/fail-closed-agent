# Secrets — never commit (except the layout README)
.secrets/*
!.secrets/README.md
*.key
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime artifacts (regenerated; not source of truth)
data/
reports/

# Runtime journals — NEVER commit. Rows carry vendor-derived market-data
# provenance (dataset/schema/instrument_id and exchange timestamps), which is
# not redistributable, and they are regenerated by every session anyway.
journal/
journal*/.lock
journal*/.lock.guard
journal-verify*/

# Agent / editor tooling state
.claude/
.omc/
.omx/

# OS
.DS_Store
*.log
