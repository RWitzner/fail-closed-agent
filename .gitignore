# Secrets — never commit (except the layout README)
.secrets/*
!.secrets/README.md
*.key
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime artifacts (regenerated; not source of truth)
data/
reports/

# High-volume journal captures (low-volume decision logs are committed)
journal/*.jsonl.gz
journal/*_book_changes.jsonl*
journal/recorder_status.json
journal/data_quality_alerts.jsonl

# Run-lock sidecars (PID lock + its persistent flock guard — NEVER delete
# .lock.guard by hand: a new inode breaks the reclaim serialization) and the
# tier-2b verification journal trees at the repo root
journal*/.lock
journal*/.lock.guard
journal-verify*/

# OMC / tooling state
.omc/
.omx/

# OS
.DS_Store
*.log
